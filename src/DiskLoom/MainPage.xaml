<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DiskLoom.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <Grid Background="{ThemeResource DiskLoomPageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True" Background="{ThemeResource DiskLoomCommandBarBrush}">
            <AppBarButton x:Uid="ScanFolderButton" Label="Scan folder" Click="ScanFolder_Click">
                <AppBarButton.Icon><FontIcon Glyph="&#xE8B7;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="CancelButton" x:Uid="CancelButton" Label="Cancel" Click="Cancel_Click" IsEnabled="False">
                <AppBarButton.Icon><FontIcon Glyph="&#xE711;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="RefreshButton" x:Uid="RefreshButton" Label="Rescan" Click="Refresh_Click" IsEnabled="False">
                <AppBarButton.Icon><FontIcon Glyph="&#xE72C;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton x:Name="ExportButton" x:Uid="ExportButton" Label="Export" Click="Export_Click" IsEnabled="False">
                <AppBarButton.Icon><FontIcon Glyph="&#xEDE1;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="SaveSnapshotButton" x:Uid="SaveSnapshotButton" Label="Save snapshot" Click="SaveSnapshot_Click" IsEnabled="False">
                <AppBarButton.Icon><FontIcon Glyph="&#xE74E;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="CompareButton" x:Uid="CompareButton" Label="Compare" Click="Compare_Click" IsEnabled="False">
                <AppBarButton.Icon><FontIcon Glyph="&#xE8AB;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton x:Uid="CheckUpdatesButton" Label="Check updates" Click="CheckUpdates_Click">
                <AppBarButton.Icon><FontIcon Glyph="&#xE895;" /></AppBarButton.Icon>
            </AppBarButton>
            <CommandBar.SecondaryCommands>
                <AppBarButton x:Uid="SettingsMenu" Label="Settings" Click="Settings_Click" />
                <AppBarButton x:Uid="CopyCurrentPathMenu" Label="Copy current path" Click="CopyPath_Click" />
                <AppBarButton x:Uid="AboutMenu" Label="About DiskLoom" Click="About_Click" />
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <Border Grid.Row="1" Padding="10,6" Background="{ThemeResource DiskLoomTreePaneBrush}" BorderBrush="{ThemeResource DiskLoomNavigationBorderBrush}" BorderThickness="0,1,0,1">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button x:Name="BackButton" MinWidth="76" Height="32" Padding="10,0" Style="{StaticResource NavigationButtonStyle}" ToolTipService.ToolTip="Back" Click="Back_Click" IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72B;" FontSize="13" />
                            <TextBlock x:Uid="BackText" Text="Back" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ForwardButton" MinWidth="88" Height="32" Padding="10,0" Style="{StaticResource NavigationButtonStyle}" ToolTipService.ToolTip="Forward" Click="Forward_Click" IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72A;" FontSize="13" />
                            <TextBlock x:Uid="ForwardText" Text="Forward" />
                        </StackPanel>
                    </Button>
                    <Border Width="1" Height="20" Margin="2,0" VerticalAlignment="Center" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Button x:Name="UpButton" MinWidth="72" Height="32" Padding="10,0" Style="{StaticResource NavigationButtonStyle}" ToolTipService.ToolTip="Up one level" Click="Up_Click" IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74A;" FontSize="13" />
                            <TextBlock x:Uid="UpText" Text="Up" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <ComboBox x:Name="DrivePicker" x:Uid="DrivePicker" Grid.Column="1" Height="32" PlaceholderText="Choose a drive" SelectionChanged="DrivePicker_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Grid Grid.Column="2">
                    <TextBox x:Name="PathBox" x:Uid="PathBox" Height="32" PlaceholderText="C:\ or \\server\share" KeyDown="PathBox_KeyDown" />
                    <BreadcrumbBar x:Name="PathBreadcrumb" MinHeight="32" VerticalAlignment="Center" Visibility="Collapsed" ItemClicked="PathBreadcrumb_ItemClicked" />
                </Grid>
                <Button x:Name="EditPathButton" Grid.Column="3" Width="34" Height="32" Style="{StaticResource NavigationButtonStyle}" Visibility="Collapsed" ToolTipService.ToolTip="Edit path" Click="EditPath_Click">
                    <FontIcon Glyph="&#xE70F;" FontSize="13" />
                </Button>
                <Button x:Uid="ScanPathButton" Grid.Column="4" Content="Scan" Height="32" Style="{StaticResource AccentButtonStyle}" Click="ScanPath_Click" />
            </Grid>
        </Border>

        <Grid x:Name="WorkspaceGrid" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreePaneColumn" Width="420" MinWidth="240" MaxWidth="640" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Padding="10,6,6,8" Background="{ThemeResource DiskLoomTreePaneBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="FolderTreeHeader" Text="Folder tree" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource DiskLoomTealBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TreeCountText" x:Uid="TreeCountText" Grid.Column="1" Text="No scan" Foreground="{ThemeResource DiskLoomBlueBrush}" VerticalAlignment="Center" />
                </Grid>
                <TreeView x:Name="DirectoryTree" Grid.Row="1" Margin="0,4,0,0" SelectionMode="Single" SelectionChanged="DirectoryTree_SelectionChanged" Expanding="DirectoryTree_Expanding" ItemInvoked="DirectoryTree_ItemInvoked">
                    <TreeView.ItemTemplate>
                        <DataTemplate>
                            <Grid MinWidth="190" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{Binding Content.Glyph}" FontSize="14" Foreground="{ThemeResource DiskLoomCyanBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Content.Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Content.PrimarySizeText}" FontSize="11" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>

            <Thumb x:Name="TreeSplitter" Grid.Column="1" Background="{ThemeResource DiskLoomSplitterTrackBrush}" DragDelta="TreeSplitter_DragDelta" DoubleTapped="TreeSplitter_DoubleTapped" PointerEntered="TreeSplitter_PointerEntered" PointerExited="TreeSplitter_PointerExited">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="{TemplateBinding Background}">
                            <Border Width="2" HorizontalAlignment="Center" Background="{ThemeResource DiskLoomBlueBrush}" Opacity="0.72" />
                            <Border Width="10" Height="72" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="5" Background="{ThemeResource DiskLoomBlueBrush}">
                                <TextBlock Text="⋮" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <TabView x:Name="WorkspaceTabs" Grid.Column="2" IsAddTabButtonVisible="False" Margin="2,2,6,6" SelectionChanged="WorkspaceTabs_SelectionChanged">
                <TabViewItem x:Uid="OverviewTab" Header="Overview" IsClosable="False">
                    <Grid Padding="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource LogicalMetricCardStyle}">
                                <StackPanel>
                                    <TextBlock x:Uid="LogicalSizeLabel" Text="Logical size" Foreground="{ThemeResource DiskLoomBlueBrush}" FontWeight="SemiBold" />
                                    <TextBlock x:Name="LogicalSizeText" Text="—" FontSize="21" FontWeight="SemiBold" Foreground="{ThemeResource DiskLoomMetricTextBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource AllocatedMetricCardStyle}">
                                <StackPanel>
                                    <TextBlock x:Uid="AllocatedSizeLabel" Text="Size on disk" Foreground="{ThemeResource DiskLoomCyanBrush}" FontWeight="SemiBold" />
                                    <TextBlock x:Name="AllocatedSizeText" Text="—" FontSize="21" FontWeight="SemiBold" Foreground="{ThemeResource DiskLoomMetricTextBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource FilesMetricCardStyle}">
                                <StackPanel>
                                    <TextBlock x:Uid="FilesLabel" Text="Files" Foreground="{ThemeResource DiskLoomVioletBrush}" FontWeight="SemiBold" />
                                    <TextBlock x:Name="FilesText" Text="—" FontSize="21" FontWeight="SemiBold" Foreground="{ThemeResource DiskLoomMetricTextBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource FoldersMetricCardStyle}">
                                <StackPanel>
                                    <TextBlock x:Uid="FoldersLabel" Text="Folders" Foreground="{ThemeResource DiskLoomTealBrush}" FontWeight="SemiBold" />
                                    <TextBlock x:Name="FoldersText" Text="—" FontSize="21" FontWeight="SemiBold" Foreground="{ThemeResource DiskLoomMetricTextBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,6,0,6" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FilterBox" x:Uid="FilterBox" PlaceholderText="Filter by name or path" TextChanged="FilterBox_TextChanged">
                                <TextBox.Header>Results</TextBox.Header>
                            </TextBox>
                            <ComboBox x:Name="SortBox" x:Uid="SortBox" Grid.Column="1" Header="Sort by" SelectionChanged="SortBox_SelectionChanged">
                                <ComboBoxItem x:Uid="SortSize" Content="Size" IsSelected="True" />
                                <ComboBoxItem x:Uid="SortAllocated" Content="Size on disk" />
                                <ComboBoxItem x:Uid="SortName" Content="Name" />
                                <ComboBoxItem x:Uid="SortModified" Content="Modified" />
                                <ComboBoxItem x:Uid="SortFileCount" Content="File count" />
                            </ComboBox>
                            <Button x:Name="SortDirectionButton" Grid.Column="2" Width="36" Height="32" Content="↓" FontSize="18" VerticalAlignment="Bottom" Margin="0,0,0,1" ToolTipService.ToolTip="Descending; click to reverse" Click="SortDirectionButton_Click" />
                            <CheckBox x:Name="RecursiveCheckBox" x:Uid="RecursiveCheckBox" Grid.Column="3" Content="Search subfolders" VerticalAlignment="Bottom" Margin="4,0,0,8" Checked="RecursiveCheckBox_Changed" Unchecked="RecursiveCheckBox_Changed" />
                        </Grid>

                        <Grid x:Name="ResultHeaderGrid" Grid.Row="2" Padding="6,2" Background="{ThemeResource DiskLoomResultHeaderBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition x:Name="NameResultColumn" Width="{x:Bind ResultColumns.NameWidth, Mode=OneWay}" MinWidth="140" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition x:Name="SizeResultColumn" Width="{x:Bind ResultColumns.SizeWidth, Mode=OneWay}" MinWidth="96" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition x:Name="AllocatedResultColumn" Width="{x:Bind ResultColumns.AllocatedWidth, Mode=OneWay}" MinWidth="110" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition x:Name="ModifiedResultColumn" Width="{x:Bind ResultColumns.ModifiedWidth, Mode=OneWay}" MinWidth="135" />
                                <ColumnDefinition Width="6" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" Tag="Name" Margin="0,0,6,0" Style="{StaticResource ColumnHeaderButtonStyle}" HorizontalContentAlignment="Left" Click="SortHeader_Click">
                                <TextBlock x:Name="NameHeaderText" x:Uid="NameHeaderText" Text="Name" />
                            </Button>
                            <Thumb x:Name="NameColumnSplitter" Grid.Column="2" Tag="Name" Style="{StaticResource ResultColumnSplitterStyle}" DragDelta="ResultColumnSplitter_DragDelta" DoubleTapped="ResultColumnSplitter_DoubleTapped" />
                            <Button Grid.Column="3" Tag="Size" Margin="6,0" Style="{StaticResource ColumnHeaderButtonStyle}" HorizontalContentAlignment="Right" Click="SortHeader_Click">
                                <TextBlock x:Name="SizeHeaderText" x:Uid="SizeHeaderText" Text="Size ↓" />
                            </Button>
                            <Thumb x:Name="SizeColumnSplitter" Grid.Column="4" Tag="Size" Style="{StaticResource ResultColumnSplitterStyle}" DragDelta="ResultColumnSplitter_DragDelta" DoubleTapped="ResultColumnSplitter_DoubleTapped" />
                            <Button Grid.Column="5" Tag="Allocated" Margin="6,0" Style="{StaticResource ColumnHeaderButtonStyle}" HorizontalContentAlignment="Right" Click="SortHeader_Click">
                                <TextBlock x:Name="AllocatedHeaderText" x:Uid="AllocatedHeaderText" Text="On disk" />
                            </Button>
                            <Thumb x:Name="AllocatedColumnSplitter" Grid.Column="6" Tag="Allocated" Style="{StaticResource ResultColumnSplitterStyle}" DragDelta="ResultColumnSplitter_DragDelta" DoubleTapped="ResultColumnSplitter_DoubleTapped" />
                            <Button Grid.Column="7" Tag="Modified" Margin="6,0" Style="{StaticResource ColumnHeaderButtonStyle}" HorizontalContentAlignment="Right" Click="SortHeader_Click">
                                <TextBlock x:Name="ModifiedHeaderText" x:Uid="ModifiedHeaderText" Text="Modified" />
                            </Button>
                            <Thumb x:Name="ModifiedColumnSplitter" Grid.Column="8" Tag="Modified" Style="{StaticResource ResultColumnSplitterStyle}" DragDelta="ResultColumnSplitter_DragDelta" DoubleTapped="ResultColumnSplitter_DoubleTapped" />
                        </Grid>

                        <ListView x:Name="ChildrenList" Grid.Row="3" SelectionMode="Single" DoubleTapped="ChildrenList_DoubleTapped" SelectionChanged="ChildrenList_SelectionChanged">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Uid="ShowInExplorerMenu" Text="Show in File Explorer" Click="ShowInExplorer_Click" />
                                    <MenuFlyoutItem x:Uid="CopyPathMenu" Text="Copy path" Click="CopySelectedPath_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:Uid="RecycleMenu" Text="Move to Recycle Bin" Click="RecycleSelected_Click" />
                                    <MenuFlyoutItem x:Uid="DeletePermanentlyMenu" Text="Delete permanently…" Click="DeleteSelected_Click" />
                                </MenuFlyout>
                            </ListView.ContextFlyout>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="6,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="{Binding ColumnLayout.NameWidth}" MinWidth="140" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="{Binding ColumnLayout.SizeWidth}" MinWidth="96" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="{Binding ColumnLayout.AllocatedWidth}" MinWidth="110" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="{Binding ColumnLayout.ModifiedWidth}" MinWidth="135" />
                                            <ColumnDefinition Width="6" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{Binding Glyph}" FontSize="15" Foreground="{ThemeResource DiskLoomBlueBrush}" />
                                        <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding CountText}" FontSize="10" Style="{StaticResource MutedTextStyle}" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Width="1" HorizontalAlignment="Center" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                        <TextBlock Grid.Column="3" Margin="6,0" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <Border Grid.Column="4" Width="1" HorizontalAlignment="Center" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                        <TextBlock Grid.Column="5" Margin="6,0" Text="{Binding AllocatedText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <Border Grid.Column="6" Width="1" HorizontalAlignment="Center" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                        <TextBlock Grid.Column="7" Margin="6,0" Text="{Binding ModifiedText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <Border Grid.Column="8" Width="1" HorizontalAlignment="Center" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </TabViewItem>

                <TabViewItem x:Uid="TreemapTab" Header="Treemap" IsClosable="False">
                    <Grid Padding="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Uid="TreemapHint" Text="Double-click a folder tile to drill in. The 250 largest visible items are drawn." Style="{StaticResource MutedTextStyle}" Margin="4,2,4,8" />
                        <Canvas x:Name="TreemapCanvas" Grid.Row="1" MinWidth="600" MinHeight="420" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Loaded="TreemapCanvas_Loaded" LayoutUpdated="TreemapCanvas_LayoutUpdated" SizeChanged="TreemapCanvas_SizeChanged" />
                    </Grid>
                </TabViewItem>

                <TabViewItem x:Uid="LargestFilesTab" Header="Largest files" IsClosable="False">
                    <Grid Padding="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="LargestHeaderText" x:Uid="LargestHeaderText" Text="The 1,000 largest files in this scan" Style="{StaticResource MutedTextStyle}" Margin="4,4,4,8" />
                        <ListView x:Name="LargestFilesList" Grid.Row="1" SelectionMode="Single" DoubleTapped="AnyFileList_DoubleTapped">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Path}" FontSize="11" Style="{StaticResource MutedTextStyle}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding ModifiedText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </TabViewItem>

                <TabViewItem x:Uid="TypesAgeTab" Header="Types &amp; age" IsClosable="False">
                    <Grid Padding="8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Uid="FileExtensionsHeader" Text="File extensions" FontSize="18" FontWeight="SemiBold" Margin="4,4,4,8" />
                            <ListView x:Name="ExtensionsList" Grid.Row="1">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="8,5" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Extension}" FontWeight="SemiBold" />
                                                <ProgressBar Value="{Binding Percentage}" Maximum="100" Height="3" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding CountText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding PercentageText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Uid="AgeHeader" Text="Age by last change" FontSize="18" FontWeight="SemiBold" Margin="4,4,4,8" />
                            <ListView x:Name="AgeList" Grid.Row="1">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="8,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding CountText}" FontSize="11" Style="{StaticResource MutedTextStyle}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>
                </TabViewItem>

                <TabViewItem x:Uid="DuplicatesTab" Header="Duplicates" IsClosable="False">
                    <Grid Padding="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <NumberBox x:Name="DuplicateMinimumBox" x:Uid="DuplicateMinimumBox" Header="Minimum size (MB)" Value="1" Minimum="0" SpinButtonPlacementMode="Compact" />
                            <Button x:Uid="FindDuplicatesButton" Grid.Column="1" Content="Find duplicates" VerticalAlignment="Bottom" Margin="0,0,0,1" Click="FindDuplicates_Click" />
                            <TextBlock x:Name="DuplicateSummaryText" x:Uid="DuplicateSummaryText" Grid.Column="2" Text="Scan a folder first" VerticalAlignment="Bottom" Margin="8,0,0,9" Style="{StaticResource MutedTextStyle}" />
                            <Button x:Uid="ShowDuplicateButton" Grid.Column="3" Content="Show selected in Explorer" VerticalAlignment="Bottom" Margin="0,0,0,1" Click="ShowDuplicateInExplorer_Click" />
                        </Grid>
                        <InfoBar x:Uid="DuplicateInfo" Grid.Row="1" Severity="Informational" IsOpen="True" IsClosable="False" Margin="0,10,0,8" Message="DiskLoom samples candidates first, then verifies every byte with SHA-256. It never auto-selects files for deletion." />
                        <ListView x:Name="DuplicatesList" Grid.Row="2" SelectionMode="Single" DoubleTapped="DuplicateList_DoubleTapped">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding GroupText}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="3" Text="{Binding ModifiedText}" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </TabViewItem>

                <TabViewItem x:Uid="InsightsTab" Header="Insights" IsClosable="False">
                    <Grid Padding="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Uid="InsightsHint" Text="Review-first cleanup opportunities—DiskLoom never deletes these automatically." Style="{StaticResource MutedTextStyle}" Margin="4,4,4,8" />
                        <ListView x:Name="InsightsList" Grid.Row="1" SelectionMode="Single" DoubleTapped="InsightList_DoubleTapped">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,8">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="{Binding Glyph}" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource MutedTextStyle}" />
                                                <TextBlock Text="{Binding Path}" FontSize="11" Style="{StaticResource MutedTextStyle}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding PotentialText}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </TabViewItem>

                <TabViewItem x:Uid="ChangesTab" Header="Changes" IsClosable="False">
                    <Grid Padding="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="ChangesHeaderText" x:Uid="ChangesHeaderText" Text="Save a snapshot, then compare it with a later scan." Style="{StaticResource MutedTextStyle}" Margin="4,4,4,8" />
                        <ListView x:Name="ChangesList" Grid.Row="1">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="105" />
                                            <ColumnDefinition Width="105" />
                                            <ColumnDefinition Width="105" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding OldSize}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="3" Text="{Binding NewSize}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="4" Text="{Binding Delta}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </TabViewItem>

                <TabViewItem x:Uid="IssuesTab" Header="Issues" IsClosable="False">
                    <Grid Padding="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="4,4,4,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="IssuesHeaderText" x:Uid="IssuesHeaderText" Text="Access errors and files that changed during scanning appear here." Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                            <Button x:Name="IssuesBackButton" Grid.Column="1" Click="IssuesBackButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72B;" FontSize="13" />
                                    <TextBlock x:Uid="IssuesBackText" Text="Back to previous view" />
                                </StackPanel>
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Left" Modifiers="Menu" />
                                </Button.KeyboardAccelerators>
                            </Button>
                        </Grid>
                        <ListView x:Name="IssuesList" Grid.Row="1">
                            <ListView.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Uid="ShowIssueMenu" Text="Show in File Explorer" Click="ShowIssueInExplorer_Click" />
                                    <MenuFlyoutItem x:Uid="CopyIssuePathMenu" Text="Copy path" Click="CopyIssuePath_Click" />
                                </MenuFlyout>
                            </ListView.ContextFlyout>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="3*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Type}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </TabViewItem>
            </TabView>
        </Grid>

        <Grid Grid.Row="3" Padding="12,6" Background="{ThemeResource DiskLoomStatusBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" x:Uid="StatusText" Text="Choose a folder or drive to begin." TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <ProgressBar x:Name="WorkProgress" Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Visibility="Collapsed" />
            <TextBlock x:Name="StatusDetailText" Grid.Column="2" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
        </Grid>

        <InfoBar x:Name="NotificationBar" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" MaxWidth="620" IsOpen="False" IsClosable="True">
            <InfoBar.ActionButton>
                <Button x:Name="NotificationActionButton" x:Uid="NotificationActionButton" Content="View issues" Visibility="Collapsed" Click="NotificationActionButton_Click" />
            </InfoBar.ActionButton>
        </InfoBar>
    </Grid>
</Page>
