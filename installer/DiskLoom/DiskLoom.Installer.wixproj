<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <Cultures>en-US;de-DE</Cultures>
    <OutputName>DiskLoom-Setup-x64</OutputName>
    <OutputPath>$(MSBuildProjectDirectory)\..\..\artifacts\DiskLoom\installer\</OutputPath>
    <DiskLoomVersion Condition="'$(DiskLoomVersion)' == ''">0.1.17</DiskLoomVersion>
    <DefineConstants>ProductVersion=$(DiskLoomVersion)</DefineConstants>
    <DefaultCompressionLevel>high</DefaultCompressionLevel>
    <SuppressIces>ICE03;ICE61</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <BindPath Include="$(MSBuildProjectDirectory)\..\..\artifacts\DiskLoom\win-x64">
      <BindName>Publish</BindName>
    </BindPath>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
  </ItemGroup>
</Project>
